[user]
	name = Szabolcs Surányi
	email = sbolch@pm.me
	signingkey = /home/szabolcs/.ssh/id_ed25519
[core]
	autocrlf = input
	editor = hx
	hooksPath = ~/dotfiles/git/ollama-hooks
[gpg]
	format = ssh
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[pull]
	rebase = true

[ollamaCommit]
	model = qwen3.5:4b
	timeout = 15
